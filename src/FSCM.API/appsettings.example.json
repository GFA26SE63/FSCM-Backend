{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "FSCM.API",
    "Audience": "FSCM.Clients",
    "Secret": "",
    "Algorithm": "HS256",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "Google": {
    "ClientIds": [
      "YOUR_WEB_OR_SERVER_CLIENT_ID.apps.googleusercontent.com",
      "YOUR_WINDOWS_DESKTOP_CLIENT_ID.apps.googleusercontent.com"
    ]
  },
  "VietMap": {
    "ServerApiKey": ""
  },
  "BackgroundJobs": {
    "DateTracker": {
      "Enabled": true,
      "TimeZone": "Asia/Ho_Chi_Minh",
      "RunAtLocalTime": "01:30"
    },
    "InventoryOutbox": {
      "Enabled": true,
      "PollIntervalSeconds": 15,
      "BatchSize": 50
    },
    "OrderDeadline": {
      "Enabled": true,
      "PollIntervalMinutes": 5,
      "PrepaidPaymentWindowDays": 3
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "PayOS": {
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": "",
    "PartnerCode": "",
    "ReturnUrl": "http://localhost:5173/payments/payos/success",
    "CancelUrl": "http://localhost:5173/payments/payos/cancel"
  },
  "SeedData": {
    "DefaultPassword": "LogisticsThesis@123"
  },
  "Brevo": {
    "ApiBaseUrl": "https://api.brevo.com/v3/",
    "ApiKey": "",
    "SenderEmail": "",
    "SenderName": "FSCM",
    "SmsSender": "FSCM",
    "SmsCountryCode": "84"
  },
  "RetailerActivation": {
    "DefaultOtpChannel": "Email",
    "FallbackToEmail": true
  },
  "FscmBlobStorage": {
    "ConnectionString": "",
    "ClaimEvidenceContainer": "claim-evidence",
    "WriteOffAttachmentsContainer": "write-off-attachments",
    "RetailerStorefrontContainer": "retailer-storefront-images",
    "ProductImagesContainer": "product-images",
    "ReadSasExpiryMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
